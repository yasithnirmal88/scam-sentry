# Scam Sentry — copy to .env (or export) to override defaults.
# The app reads plain environment variables; no .env loader is required.

# --- Server ---
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
# Never enable debug in production (exposes stack traces).
FLASK_DEBUG=false
LOG_LEVEL=INFO

# --- Storage ---
# SQLite file for scanned jobs + scan history.
SCAM_SENTRY_DB=scam_sentry.db
# Optional Postgres. When set, it takes precedence over the SQLite file below.
# Works with free Render / Neon / Supabase Postgres. Example:
#   DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# --- Scheduled scanning (off by default) ---
SCAN_ENABLED=false
SCAN_INTERVAL_HOURS=6
# Run one scan shortly after startup when the scheduler is enabled.
SCAN_RUN_ON_STARTUP=true
# Comma-separated subset of registered sources (empty = all):
#   remoteok,remotive,arbeitnow,jobicy,himalayas,workingnomads,larajobs,
#   greenhouse,lever,ashby
SCAN_SOURCES=
# Jobs fetched per source per run (1-100).
SCAN_LIMIT=20

# --- Scanner HTTP ---
SCANNER_TIMEOUT=20
SCANNER_RETRIES=2
SCANNER_RETRY_BACKOFF=2
SCANNER_USER_AGENT=ScamSentry/1.0 (+job-risk-research)
# Company-board scanners (Greenhouse/Lever/Ashby) walk public, no-auth board
# tokens (comma-separated). SCANNER_MAX_BOARDS caps how many are fetched per run.
SCANNER_MAX_BOARDS=6
GREENHOUSE_BOARDS=stripe,gitlab,coinbase,databricks,vercel,reddit
LEVER_BOARDS=dnb,ppgreatplains,leversys
ASHBY_BOARDS=openai,ramp,notion,linear
# Working Nomads can be slow; keep a per-source timeout floor (seconds).
WORKINGNOMADS_TIMEOUT=45

# --- Upload / OCR hardening (DoS controls) ---
# Max PDF pages read or rasterized per upload.
OCR_MAX_PDF_PAGES=5
# Rasterization DPI for scanned-PDF OCR (lower DPI = less memory).
OCR_PDF_DPI=150
# Max pixels for any single decoded image (uploaded or rasterized).
OCR_MAX_IMAGE_PIXELS=20000000

# --- Freshness bands (days) for Ghost/Stale signals ---
FRESHNESS_STALE_DAYS=60
FRESHNESS_VERY_STALE_DAYS=90

# --- Abuse & cost control ---
# Shared secret required to trigger scans (POST /api/scan) via the
# `X-Scan-Token` header. Empty = no-token dev/demo mode: scans run open only
# while LLM_ENABLED is off; the app refuses to boot with LLM_ENABLED=true
# unless a token is set. Production must set a long random value.
SCAN_API_TOKEN=
# Per-IP request rate limits (Flask-Limiter syntax: "30/minute", "100/hour").
# Tune for your deployment; the LLM layer refuses to start unless these are set.
RATE_LIMIT_ANALYZE=30/minute
RATE_LIMIT_SCAN=5/minute

# --- ML honesty ---
# GradientBoosting probabilities are over-confident and the committed model is
# synthetic-trained. Pull the ML probability toward a neutral prior so it never
# overstates itself (the rule engine sets the verdict). Off restores raw
# model output, which should not be shown as-is to end users.
ML_CALIBRATION=true
ML_CALIBRATION_PRIOR=0.5
ML_CALIBRATION_SHRINK=0.7
# Path to an EMSCAD/Kaggle fake_job_postings.csv used only by
# `python model_training.py --real [path]`. The committed model stays
# synthetic-trained unless you explicitly train on real data.
REAL_DATASET_PATH=data/fake_job_postings.csv

# --- Optional LLM enhancement layer (OFF by default) ---
# The deterministic Risk Engine stays the source of truth for the risk
# level. When enabled, the LLM only rewrites the human-facing summary and
# adds a short reasoning note. Any failure/timeout falls back to the engine.
# Works with any OpenAI-compatible endpoint (OpenAI, OpenRouter, Groq,
# Ollama /v1, vLLM, LM Studio, ...).
LLM_ENABLED=false
LLM_API_KEY=
# Base URL WITHOUT the trailing /chat/completions:
#   OpenAI      https://api.openai.com/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Groq        https://api.groq.com/openai/v1
#   Ollama      http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=12
LLM_MAX_TOKENS=400
LLM_TEMPERATURE=0.2
# Also enhance automatically-scanned listings? Off = scans stay zero-token.
LLM_SCANNER_ENABLED=false
